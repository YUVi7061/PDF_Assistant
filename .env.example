# Local development / hosted deployment settings. Keep all secrets blank in this template.
GROQ_API_KEY=
GROQ_GEN_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

DEFAULT_GENERATION_MODEL=groq-llama
DEFAULT_EMBEDDING_MODEL=gemini-embed
REWRITE_MODEL=groq-llama
JUDGE_MODEL=groq-llama

CHUNK_SIZE=1800
CHUNK_OVERLAP=300
TOP_K=5
MIN_SCORE=0.15
MAX_UPLOAD_MB=4

# Vercel/Supabase only. Never expose the service-role key in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pdf-assistant-vectors
APP_ACCESS_TOKEN=
BACKEND_URL=http://localhost:8000

# Optional local embeddings and guardrails
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
AWS_REGION=us-east-1
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT